# Copy to .env and fill in. .env is gitignored — it holds a credential.
#
# Generate the initial token on your workstation with:
#   npx -p ring-client-api ring-auth-cli
#
# This seed value is only used on first startup. After that the container
# persists rotated tokens to its /data volume and ignores this variable.
RING_REFRESH_TOKEN=

# Comma-separated camera names exactly as they appear in the Ring app.
# Leave empty to monitor every camera on the account.
CAMERA_NAMES=

# Host directory for recordings. Any absolute or relative path; this is the
# location the videos are visible at from outside the container.
RECORDINGS_PATH=./recordings

# Ownership of saved files. Set these to the host user that should own the
# recordings so they are readable/deletable outside the container:
#   id -u   ->  PUID
#   id -g   ->  PGID
# Matters on Linux and NAS devices. Docker Desktop (macOS/Windows) remaps
# ownership automatically, so the defaults are fine there.
PUID=1000
PGID=1000

# Permissions for saved videos and snapshots, in octal.
#   644 = owner writes, everyone reads (default; good for browsing/serving)
#   600 = owner only
FILE_MODE=644

# MINIMUM seconds of video per event (5-300). Clips run longer while Ring keeps
# reporting activity, so a visitor who lingers is not cut off mid-event.
RECORD_SECONDS=30

# Keep recording while the event is still going. Ring sends no "motion ended"
# signal, but it re-sends a notification every few seconds while it still sees
# something, so repeat notifications stand in for continued presence.
EXTEND_ON_ACTIVITY=true

# Stop this long after the last sign of activity (5-120). Must comfortably exceed
# the gap between Ring's repeat notifications or recordings stop early.
EXTEND_SECONDS=20

# Hard ceiling on a single recording (5-900). Ring live sessions do not last
# forever, streaming drains battery models, and one event should not fill the disk.
MAX_RECORD_SECONDS=120

# Quiet period after a recording before the same camera can trigger again.
# Ring fires several notifications per real event; this prevents duplicates.
COOLDOWN_SECONDS=60

# Also save a JPEG thumbnail alongside each video. The thumbnail is a frame taken
# from the recording itself, so it shows the event rather than an empty doorstep.
CAPTURE_SNAPSHOT=true

# How far into the clip to take that frame. The first moments of a Ring stream are
# often a grey keyframe while the encoder settles, so 0 makes a poor thumbnail.
# Clamped below RECORD_SECONDS.
THUMBNAIL_OFFSET_SECONDS=2

# Which event types to record.
RECORD_MOTION=true
RECORD_DING=true

# Retention. Both limits apply; set either to 0 to disable it.
RETENTION_DAYS=14
RETENTION_MAX_GB=20

# Read-only web UI for browsing recordings. Off by default: it serves video of
# your front door, so enabling it should be a deliberate choice.
WEB_ENABLED=false

# Port inside the container, and the host port it is published on. Change
# WEB_HOST_PORT if something else already has 8080 (Synology DSM does).
WEB_PORT=8080
WEB_HOST_PORT=8080

# HTTP basic auth for the web UI. Both must be set, or both left empty for no
# authentication at all. Set them unless nothing untrusted can reach the port —
# guest Wi-Fi and IoT devices on the same LAN can.
WEB_USERNAME=
WEB_PASSWORD=

# CIDRs whose clients skip the password, e.g. 192.168.1.0/24, or "default" for
# the usual private ranges. Only works where the app sees real client
# addresses — on a Docker bridge network every request appears to come from the
# bridge gateway, so a matching rule would exempt everything, port forwards
# included. Check `curl http://localhost:8080/whoami` before relying on this.
TRUSTED_NETWORKS=

# Timezone for log and filename timestamps.
TZ=Europe/London

# Set to true for verbose ffmpeg and API logging.
DEBUG=false

# Set to "host" on Linux if WebRTC streams fail to connect.
NETWORK_MODE=bridge

# Node version used inside the container. The host's Node version does not
# matter. ring-client-api declares support for 20, 22 and 24; 22 is current LTS.
NODE_VERSION=22
